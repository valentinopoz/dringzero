{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dringzero",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero",
			"database_id": "25e66118-ffe0-4cf9-9de3-14b1f01ac323",
		}
	]
}